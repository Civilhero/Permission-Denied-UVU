# Built data for maps (regenerated on load)
*_BuiltData.uasset

# Crash reports
CrashReportClient/

# ===== Packaging / Builds =====
*.pak
*.sig

# ===== OS junk =====
.DS_Store
Thumbs.db
desktop.ini

# ===== Secrets — never commit credentials =====
Config/Secrets/
*.ini.bak

# ===== Whitelist project files that should stay tracked =====
!*.uproject
!*.uplugin
!Config/**/*.ini
!Content/**/*.uasset
!Content/**/*.umap
!Source/**/*.cpp
!Source/**/*.h
!Source/**/*.Build.cs
!Source/**/*.Target.cs
