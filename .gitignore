.vscode/
.idea/
*.sln
*.slnx
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.xcodeproj
*.xcworkspace

# Engine-generated intermediate/cache folders
Binaries/
Build/
Intermediate/
DerivedDataCache/
Saved/
.ue4/
.ue5/

# Same folders inside any Plugin
Plugins/**/Binaries/
Plugins/**/Build/
Plugins/**/Intermediate/

# Compiled source
*.o
*.obj
*.slo
*.lo
*.gch
*.pch

# Compiled libraries/executables
*.so
*.dylib
*.dll
*.lai
*.la
*.a
*.lib
*.exe
*.out
*.app
